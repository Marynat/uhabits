<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <ImageView
        android:id="@+id/weeklyRowImage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:adjustViewBounds="true"
        android:scaleType="fitCenter" />

    <!-- Padding is set in code so that weeklyRowTap covers only today's box. -->
    <FrameLayout
        android:id="@+id/weeklyRowTapArea"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <FrameLayout
            android:id="@+id/weeklyRowTap"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/widget_weekly_habits_tap" />
    </FrameLayout>
</FrameLayout>
