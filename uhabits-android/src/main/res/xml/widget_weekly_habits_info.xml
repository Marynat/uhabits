<!-- Sizes: 4x2 cells by default, resizable down to 3x1. minWidth/minHeight use the
     70 * cells - 30 rule for launchers older than Android 12. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/weekly_habits_widget_description"
    android:initialLayout="@layout/widget_weekly_habits"
    android:minWidth="250dp"
    android:minHeight="110dp"
    android:minResizeWidth="180dp"
    android:minResizeHeight="40dp"
    android:previewImage="@drawable/widget_preview_checkmark"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:updatePeriodMillis="3600000"
    android:widgetCategory="home_screen" />
